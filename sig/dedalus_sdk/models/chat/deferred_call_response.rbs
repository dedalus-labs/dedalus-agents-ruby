module DedalusSDK
  module Models
    module Chat
      type deferred_call_response =
        {
          id: String,
          name: String,
          arguments: DedalusSDK::Models::json_object_input,
          blocked_by: ::Array[String],
          dependencies: ::Array[String],
          venue: String
        }

      class DeferredCallResponse < DedalusSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor name: String

        attr_reader arguments: DedalusSDK::Models::json_object_input?

        def arguments=: (
          DedalusSDK::Models::json_object_input
        ) -> DedalusSDK::Models::json_object_input

        attr_reader blocked_by: ::Array[String]?

        def blocked_by=: (::Array[String]) -> ::Array[String]

        attr_reader dependencies: ::Array[String]?

        def dependencies=: (::Array[String]) -> ::Array[String]

        attr_reader venue: String?

        def venue=: (String) -> String

        def initialize: (
          id: String,
          name: String,
          ?arguments: DedalusSDK::Models::json_object_input,
          ?blocked_by: ::Array[String],
          ?dependencies: ::Array[String],
          ?venue: String
        ) -> void

        def to_hash: -> {
          id: String,
          name: String,
          arguments: DedalusSDK::Models::json_object_input,
          blocked_by: ::Array[String],
          dependencies: ::Array[String],
          venue: String
        }
      end
    end
  end
end
