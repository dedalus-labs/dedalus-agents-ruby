        instructions: DedalusSDK::Models::Response::instructions?,
        max_output_tokens: Integer?,
        max_tool_calls: Integer?,
        mcp_server_errors: ::Hash[Symbol, DedalusSDK::Response::MCPServerError]?,
        mcp_tool_results: ::Array[DedalusSDK::MCPToolResult]?,
