      type status =
        :completed | :failed | :in_progress | :cancelled | :queued | :incomplete

      module Status
        extend DedalusSDK::Internal::Type::Enum

        COMPLETED: :completed
        FAILED: :failed
        IN_PROGRESS: :in_progress
        CANCELLED: :cancelled
        QUEUED: :queued
        INCOMPLETE: :incomplete

        def self?.values: -> ::Array[DedalusSDK::Models::Response::status]
      end

      type instructions =
        String | ::Array[DedalusSDK::Models::json_object_input]

      module Instructions
        extend DedalusSDK::Internal::Type::Union

        def self?.variants: -> ::Array[DedalusSDK::Models::Response::instructions]

        JSONObjectInputArray: DedalusSDK::Internal::Type::Converter
      end

      type mcp_server_error =
        { message: String, code: String?, recommendation: String? }

      class MCPServerError < DedalusSDK::Internal::Type::BaseModel
        attr_accessor message: String

        attr_accessor code: String?

        attr_accessor recommendation: String?

        def initialize: (
          message: String,
          ?code: String?,
          ?recommendation: String?
        ) -> void

        def to_hash: -> {
          message: String,
          code: String?,
          recommendation: String?
        }
      end

      type object = :response

      module Object
        extend DedalusSDK::Internal::Type::Enum

        RESPONSE: :response

        def self?.values: -> ::Array[DedalusSDK::Models::Response::object]
      end

      type tool_choice = String | DedalusSDK::Models::json_object_input

      module ToolChoice
        extend DedalusSDK::Internal::Type::Union

        def self?.variants: -> ::Array[DedalusSDK::Models::Response::tool_choice]
      end
    end
