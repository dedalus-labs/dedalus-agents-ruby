    type response =
      {
        id: String,
        created_at: Float,
        model: String,
        output: ::Array[DedalusSDK::Models::json_object_input],
        status: DedalusSDK::Models::Response::status,
        background: bool?,
        completed_at: Float?,
        conversation: DedalusSDK::Models::json_object_input?,
        error: DedalusSDK::Models::json_object_input?,
        frequency_penalty: Float?,
