      attr_accessor is_error: bool

      attr_accessor server_name: String

      attr_accessor tool_name: String

      attr_accessor duration_ms: Integer?

      attr_accessor result: DedalusSDK::Models::json_value_input?

      def initialize: (
        arguments: DedalusSDK::Models::json_object_input,
        is_error: bool,
        server_name: String,
        tool_name: String,
        ?duration_ms: Integer?,
        ?result: DedalusSDK::Models::json_value_input?
      ) -> void

      def to_hash: -> {
        arguments: DedalusSDK::Models::json_object_input,
        is_error: bool,
        server_name: String,
        tool_name: String,
        duration_ms: Integer?,
        result: DedalusSDK::Models::json_value_input?
