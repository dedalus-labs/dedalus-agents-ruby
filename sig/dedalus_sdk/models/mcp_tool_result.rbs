module DedalusSDK
  module Models
    type mcp_tool_result =
      {
        arguments: DedalusSDK::Models::json_object_input,
        is_error: bool,
        server_name: String,
        tool_name: String,
        duration_ms: Integer?,
        result: DedalusSDK::Models::json_value_input?
      }

    class MCPToolResult < DedalusSDK::Internal::Type::BaseModel
